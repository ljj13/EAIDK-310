def cmd_health(args) -> int:
    boot_dir = pathlib.Path(args.boot_dir)
    critical = []

    def crit(name, ok, detail=""):
        critical.append({"check": name, "ok": bool(ok), "detail": detail})

    release = subprocess.run(["uname", "-r"], text=True, capture_output=True).stdout.strip()
    crit("kernel_release", bool(release), release)
    if args.expected_release:
        crit("kernel_is_candidate", release == args.expected_release,
             f"{release} vs {args.expected_release}")
    root_rw = run(["findmnt", "-n", "-o", "OPTIONS", "/"]).stdout
    crit("root_rw", "rw" in root_rw.split(",") if root_rw else False, root_rw.strip())
    running = run(["systemctl", "is-system-running"]).stdout.strip()
    crit("systemd_running", running in ("running", "degraded"), running)
    crit("boot_readable", (boot_dir / "extlinux" / "extlinux.conf").exists(), str(boot_dir))
    crit("emmc_present", pathlib.Path("/dev/mmcblk2").exists(), "/dev/mmcblk2")
    eth = pathlib.Path("/sys/class/net/eth0")
    crit("eth0_present", eth.exists(), str(eth))
    zram_comp = pathlib.Path("/sys/block/zram0/comp_algorithm")
    comp = zram_comp.read_text() if zram_comp.exists() else ""
    crit("zram_present", pathlib.Path("/dev/zram0").exists(), "/dev/zram0")
    crit("zram_lz4", "[lz4]" in comp, comp.strip())
    thermal_ok = any(pathlib.Path(f"/sys/class/thermal/thermal_zone{i}/temp").exists()
                     for i in range(6))
    crit("thermal_readable", thermal_ok, "thermal_zone*")
    if os.geteuid() == 0:
        dmesg = run(["dmesg"]).stdout
    else:
        r = run(["sudo", "-n", "dmesg"])
        dmesg = r.stdout if r.returncode == 0 and r.stdout.strip() else run(
            ["journalctl", "-k", "-b", "--no-pager"]).stdout
    bad = [ln for ln in dmesg.splitlines()
           if re.search(r"Kernel panic|Oops", ln, re.I)]
    crit("no_panic_oops", not bad, f"{len(bad)} hits")
    for mnt in ("/", "/boot"):
        crit(f"mount{mnt}", run(["findmnt", "-n", mnt]).returncode == 0, mnt)

    critical_pass = all(c["ok"] for c in critical)

    remote = []
    def remote_check(name, ok, detail=""):
        remote.append({"check": name, "ok": bool(ok), "detail": detail})

    attempts = max(1, args.network_retries)
    for attempt in range(attempts):
        remote.clear()
        v4 = run(["ip", "-4", "-br", "addr", "show", "eth0"]).stdout
        remote_check("dhcpv4", "172.31." in v4 or re.search(r"\d+\.\d+\.\d+\.\d+", v4) is not None, v4.strip())
        remote_check("gw4", run(["ping", "-c1", "-W2", "172.31.180.33"]).returncode == 0)
        remote_check("portal4", run(["curl", "-4", "-sS", "-o", "/dev/null", "-w", "%{http_code}",
                                     "--max-time", "8", "http://net.szu.edu.cn/"]).returncode == 0)
        v6addr = run(["ip", "-6", "-br", "addr", "show", "eth0", "scope", "global"]).stdout
        remote_check("v6_addr", bool(v6addr.strip()), v6addr.strip())
        remote_check("v6_internet", run(["curl", "-6", "-sS", "-o", "/dev/null", "-w", "%{http_code}",
                                         "--max-time", "12", "https://www.debian.org/"]).returncode == 0)
        remote_check("v6_dns", run(["nslookup", "-timeout=4", "debian.org"]).returncode == 0)
        remote_check("shellcrash", run(["systemctl", "is-active", "shellcrash"]).stdout.strip() == "active")
        proxy = run(["curl", "-x", "http://127.0.0.1:7890", "-sS", "-o", "/dev/null", "-w", "%{http_code}",
                     "--max-time", "12", "http://www.gstatic.com/generate_204"])
        remote_check("proxy7890_v4", proxy.stdout.strip().endswith(("204", "200")),
                     proxy.stdout.strip())
        remote_check("tailscaled", run(["systemctl", "is-active", "tailscaled"]).stdout.strip() == "active")
        ts = run(["tailscale", "status"]).stdout
        remote_check("tailscale_online", "eaidk-310" in ts, ts.splitlines()[0][:60] if ts else "")
        if all(r["ok"] for r in remote):
            break
        if attempt + 1 < attempts:
            time.sleep(args.network_retry_wait)

    remote_pass = all(r["ok"] for r in remote)
    result = {"critical": critical, "critical_pass": critical_pass,
              "remote": remote, "remote_pass": remote_pass,
              "remote_attempts": attempt + 1,
              "checked_at": now_iso()}
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        for c in critical:
            print(f"  CRIT {'PASS' if c['ok'] else 'FAIL'}  {c['check']}  {c['detail']}")
        for c in remote:
            print(f"  REMO {'PASS' if c['ok'] else 'FAIL'}  {c['check']}  {c['detail']}")
        print(f"CRITICAL_BOOT_HEALTH={'PASS' if critical_pass else 'FAIL'}")
        print(f"REMOTE_HEALTH={'PASS' if remote_pass else 'FAIL'}")
    if not critical_pass:
        return EXIT_HEALTH_CRITICAL
    if not remote_pass:
        return EXIT_HEALTH_REMOTE
    # P8.2: a passing health run on the candidate kernel is the
    # ARMED -> HEALTHY transition the commit path requires.
    state = StateStore(pathlib.Path(args.state_dir))
    data = state.read()
    release = data.get("release")
    if data.get("state") == "ARMED" and release and             release in pathlib.Path("/proc/cmdline").read_text():
        state.write("HEALTHY", release=release,
                    bundle_sha256=data.get("bundle_sha256"),
                    candidate_identity=data.get("candidate_identity"),
                    note="health PASS on the candidate kernel")
        print(f"state: ARMED -> HEALTHY ({release})")
    return EXIT_OK


