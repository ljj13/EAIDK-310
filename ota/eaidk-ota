#!/usr/bin/env python3
"""eaidk-ota - fail-safe kernel OTA framework for EAIDK-310.

Design contract (P3.5):
  - fail closed: every boot-chain mutation requires explicit local
    (physical console) authorization; remote sessions can never authorize.
  - fail-safe boot backend is a hard prerequisite for `try`/`arm`.
    Current backend status: BLOCKED (see `try` refusal message).
  - atomic writes: every persisted file is written via tmp+fsync+rename.
  - structured: all commands support --json; exit codes are stable.

Exit codes:
  0  success
  1  general error
  2  verification failed
  3  authorization required / denied
  4  fail-safe boot backend unavailable
  5  state conflict (e.g. same release, different hash)
  6  health check failed (critical)
  7  health check degraded (remote layer only)
"""

import argparse
import fcntl
import json
import os
import pathlib
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone

VERSION = "0.1.0"

EXIT_OK = 0
EXIT_ERROR = 1
EXIT_VERIFY = 2
EXIT_AUTH = 3
EXIT_BACKEND = 4
EXIT_CONFLICT = 5
EXIT_HEALTH_CRITICAL = 6
EXIT_HEALTH_REMOTE = 7

DEFAULT_STATE_DIR = "/var/lib/eaidk-ota"
DEFAULT_CONFIG_DIR = "/etc/eaidk-ota"
DEFAULT_BOOT_DIR = "/boot"
DEFAULT_RUN_DIR = "/run/eaidk-ota"
LOCK_NAME = "locks"
HISTORY_NAME = "history"
STAGING_NAME = "staging"
STATE_FILE = "state.json"
AUTH_TOKEN = "local-authorization"
AUTH_TTL_SECONDS = 15 * 60
ALLOW_FLAG = "allow-boot-mutation"
LOCAL_TTYS = ("/dev/ttyS2", "/dev/tty1")

STATES = (
    "IDLE", "VERIFIED", "STAGED", "ARMED", "BOOTING", "HEALTH_PENDING",
    "HEALTHY", "COMMITTED", "ROLLBACK_PENDING", "ROLLED_BACK", "FAILED",
)

# Fail-safe boot backend status.  BLOCKED until a U-Boot with a proven
# rollback mechanism is installed AND validated by on-site fault injection.
FAILSAFE_BOOT_BACKEND = "RAW_REDUNDANT"
FAILSAFE_BOOT_BACKEND_REASON = (
    "RawBootstateBackend (P3.6-B failsafe-raw U-Boot, dual-copy bootstate "
    "at eMMC LBA 0x6400/0x7800 + diagnostic breadcrumb at 0x6C00) flashed "
    "and validated by remote bootstrap 2026-10-01: CHECKPOINT_1/2/3 PASS "
    "(unarmed stable boot, marker-proof candidate path, real panic "
    "rollback to 111 stable).  Roles: 108=RESCUE, 111=STABLE/default, "
    "6.18.54=CANDIDATE (staged)."
)


class BackendError(Exception):
    pass


# ------------------------------------------------------------ boot backend --

class BootBackend:
    """Interface for the fail-safe boot backend used by try/arm/commit."""

    name = "NoBackend"

    def available(self) -> bool:
        raise NotImplementedError

    def unavailable_reason(self) -> str:
        raise NotImplementedError


class NoBackend(BootBackend):
    """No usable rollback mechanism: every boot-chain mutation is refused."""

    name = "NoBackend"

    def available(self) -> bool:
        return False

    def unavailable_reason(self) -> str:
        return FAILSAFE_BOOT_BACKEND_REASON


class BootcountFsBackend(BootBackend):
    """P3.6 candidate-A backend: U-Boot BOOTCOUNT_EXT + eaidk-bootstate.

    Boot trial state lives in a 4-byte record at <boot>/eaidk-ota/
    bootcount.bin, shared with U-Boot's bootcount_ext driver.  This backend
    only activates when the fail-safe U-Boot install marker exists on the
    boot filesystem (written by the future on-site flash procedure);
    selection otherwise degrades to NoBackend (fail closed).
    """

    name = "BootcountFsBackend"
    MARKER_REL = "eaidk-ota/BACKEND"
    STATE_REL = "eaidk-ota/bootcount.bin"
    MARKER_CONTENT = "BootcountFsBackend 1"

    def __init__(self, boot_dir: pathlib.Path, tool: str = "eaidk-bootstate"):
        self.boot_dir = pathlib.Path(boot_dir)
        self.tool = tool

    def marker_path(self) -> pathlib.Path:
        return self.boot_dir / self.MARKER_REL

    def state_path(self) -> pathlib.Path:
        return self.boot_dir / self.STATE_REL

    def available(self) -> bool:
        try:
            return self.marker_path().read_text(
                encoding="utf-8").strip() == self.MARKER_CONTENT
        except OSError:
            return False

    def unavailable_reason(self) -> str:
        return (f"{self.name} is not installed: missing or invalid marker "
                f"{self.marker_path()}. The fail-safe U-Boot (P3.6 candidate "
                "A) must be flashed and validated on-site first.")

    def _run_bootstate(self, subcommand: str) -> subprocess.CompletedProcess:
        return run([self.tool, subcommand, str(self.state_path()), "--json"])

    @staticmethod
    def fs_has_metadata_csum(dumpe2fs_output: str) -> bool:
        """U-Boot v2024.07 ext4fs_write() refuses ext4 filesystems with the
        metadata_csum feature (drivers/../fs/ext4/ext4_write.c).  On such a
        filesystem the bootcount increment can never persist, so an armed
        trial would repeat forever -- arm must refuse up front."""
        for line in dumpe2fs_output.splitlines():
            if line.startswith("Filesystem features:"):
                return "metadata_csum" in line
        return False

    def _boot_fs_metadata_csum(self):
        """True/False when the boot filesystem is detectable, None when not
        (PC/fixture mode or missing tools) -- the gate only fires on proof."""
        dev = run(["findmnt", "-no", "SOURCE",
                   str(self.boot_dir)]).stdout.strip()
        if not dev or not pathlib.Path(dev).exists():
            return None
        r = run(["dumpe2fs", "-h", dev])
        if r.returncode != 0:
            return None
        return self.fs_has_metadata_csum(r.stdout)

    def arm(self) -> dict:
        if self._boot_fs_metadata_csum():
            raise BackendError(
                f"{self.boot_dir} filesystem has ext4 metadata_csum: U-Boot "
                "v2024.07 cannot write the bootcount there, so a candidate "
                "trial would repeat forever without a working fallback. "
                "Remedy on-site BEFORE arming: umount /boot && e2fsck -f "
                "<dev> && tune2fs -O ^metadata_csum <dev> && e2fsck -f "
                "<dev> && mount /boot (see ota/docs/FLASH-PLAN-P36.md).")
        r = self._run_bootstate("arm")
        if r.returncode != 0:
            raise BackendError(
                f"eaidk-bootstate arm failed: {r.stdout.strip()} {r.stderr.strip()}")
        return json.loads(r.stdout)

    def clear(self) -> dict:
        r = self._run_bootstate("clear")
        if r.returncode != 0:
            raise BackendError(
                f"eaidk-bootstate clear failed: {r.stdout.strip()} {r.stderr.strip()}")
        return json.loads(r.stdout)

    def inspect(self) -> dict:
        r = self._run_bootstate("inspect")
        if r.returncode != 0:
            raise BackendError(
                f"eaidk-bootstate inspect failed: {r.stdout.strip()} {r.stderr.strip()}")
        return json.loads(r.stdout)


class RawBootstateBackend(BootBackend):
    """P3.6-B candidate-B backend: U-Boot bootcount_eaidk310_raw + the raw
    dual-copy record pair on fixed eMMC sectors (LBA 0x6400 / 0x7800).

    State lives in two CRC32-protected 512-byte records inside the
    unpartitioned 12-16 MiB tail -- no filesystem involvement at all.
    Activation requires the fail-safe U-Boot install marker exactly like
    the ext4 backend; writes additionally flow through eaidk-bootstate's
    --allow-block-write gate and only ever target the two audited sectors.
    """

    name = "RawBootstateBackend"
    STATE_REL = "eaidk-ota/BACKEND"  # marker shared with BootcountFsBackend

    def __init__(self, boot_dir: pathlib.Path, tool: str = "eaidk-bootstate",
                 raw_device: str = "/dev/mmcblk2"):
        self.boot_dir = pathlib.Path(boot_dir)
        self.tool = tool
        self.raw_device = raw_device

    def state_path(self) -> pathlib.Path:
        return pathlib.Path(self.raw_device)

    def marker_path(self) -> pathlib.Path:
        return self.boot_dir / self.STATE_REL

    def available(self) -> bool:
        try:
            return self.marker_path().read_text(
                encoding="utf-8").strip() == f"{self.name} 1"
        except OSError:
            return False

    def unavailable_reason(self) -> str:
        return (f"{self.name} is not installed: missing or invalid marker "
                f"{self.marker_path()}. The failsafe-raw U-Boot (P3.6-B "
                "candidate B) must be flashed and validated on-site first.")

    def _run_bootstate(self, subcommand: str, extra: list) -> subprocess.CompletedProcess:
        cmd = [self.tool, subcommand, "--backend", "raw",
               "--raw-device", self.raw_device,
               "--allow-block-write", "--json"] + extra
        return run(cmd)

    def arm(self) -> dict:
        r = self._run_bootstate("arm", [])
        if r.returncode != 0:
            raise BackendError(
                f"eaidk-bootstate raw arm failed: {r.stdout.strip()} {r.stderr.strip()}")
        return json.loads(r.stdout)

    def clear(self) -> dict:
        r = self._run_bootstate("clear", [])
        if r.returncode != 0:
            raise BackendError(
                f"eaidk-bootstate raw clear failed: {r.stdout.strip()} {r.stderr.strip()}")
        return json.loads(r.stdout)

    def inspect(self) -> dict:
        r = self._run_bootstate("inspect", [])
        if r.returncode != 0:
            raise BackendError(
                f"eaidk-bootstate raw inspect failed: {r.stdout.strip()} {r.stderr.strip()}")
        return json.loads(r.stdout)


def select_backend(boot_dir: pathlib.Path, choice: str = "auto",
                   tool: str = "eaidk-bootstate",
                   raw_device: str = "/dev/mmcblk2") -> BootBackend:
    """Backend selection is fail closed: anything unexpected -> NoBackend."""
    if choice == "none":
        return NoBackend()
    if choice == "bootcount-fs":
        return BootcountFsBackend(boot_dir, tool)
    if choice == "raw":
        return RawBootstateBackend(boot_dir, tool, raw_device)
    # auto: the /boot marker names the activated backend; no marker (or an
    # unknown one) means NoBackend on the board
    marker = pathlib.Path(boot_dir) / "eaidk-ota" / "BACKEND"
    try:
        content = marker.read_text(encoding="utf-8").strip()
    except OSError:
        return NoBackend()
    if content == f"{BootcountFsBackend.name} 1":
        return BootcountFsBackend(boot_dir, tool)
    if content == f"{RawBootstateBackend.name} 1":
        return RawBootstateBackend(boot_dir, tool, raw_device)
    return NoBackend()


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def atomic_write(path: pathlib.Path, data: str, mode: int = 0o644) -> None:
    """tmp + fsync + rename write. Never leaves partial files."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(data)
        fh.flush()
        os.fsync(fh.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, path)
    dirfd = os.open(str(path.parent), os.O_DIRECTORY)
    try:
        os.fsync(dirfd)
    finally:
        os.close(dirfd)


def sha256_file(path: pathlib.Path) -> str:
    import hashlib
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def run(cmd, **kw) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(cmd, text=True, capture_output=True, **kw)
    except FileNotFoundError:
        # a missing probe tool is a failed check, never a crash
        return subprocess.CompletedProcess(cmd, returncode=127,
                                           stdout="", stderr=f"tool not found: {cmd[0]}")


def fail_exit(code: int, message: str, payload=None) -> int:
    out = {"ok": False, "error": message}
    if payload:
        out.update(payload)
    print(json.dumps(out, sort_keys=True) if os.environ.get("EAIDK_OTA_JSON") else message)
    return code


class StateStore:
    """Atomic JSON state + append-only history under <state_dir>."""

    def __init__(self, state_dir: pathlib.Path):
        self.dir = state_dir
        self.file = state_dir / STATE_FILE
        self.history = state_dir / HISTORY_NAME
        self.lockpath = state_dir / LOCK_NAME / "eaidk-ota.lock"

    def ensure_dirs(self):
        for sub in ("", HISTORY_NAME, STAGING_NAME, "backups", LOCK_NAME):
            (self.dir / sub).mkdir(parents=True, exist_ok=True)

    class Lock:
        def __init__(self, path):
            self.path = path
            self.fh = None

        def __enter__(self):
            self.path.parent.mkdir(parents=True, exist_ok=True)
            self.fh = open(self.path, "w")
            fcntl.flock(self.fh, fcntl.LOCK_EX)
            return self

        def __exit__(self, *a):
            fcntl.flock(self.fh, fcntl.LOCK_UN)
            self.fh.close()

    def locked(self):
        self.ensure_dirs()
        return StateStore.Lock(self.lockpath)

    def read(self) -> dict:
        if not self.file.exists():
            return {"state": "IDLE", "updated": now_iso(), "history": []}
        try:
            return json.loads(self.file.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            # corrupted state is never trusted; rebuild conservatively as IDLE
            return {"state": "IDLE", "updated": now_iso(),
                    "note": "state.json was unreadable and was reset to IDLE"}

    def write(self, state: str, **extra) -> dict:
        data = self.read()
        prev = data.get("state", "IDLE")
        data.update({"state": state, "previous_state": prev,
                     "updated": now_iso()})
        data.update(extra)
        atomic_write(self.file, json.dumps(data, indent=2, sort_keys=True) + "\n")
        self.history.mkdir(parents=True, exist_ok=True)
        entry = {"at": now_iso(), "from": prev, "to": state}
        entry.update(extra)
        with open(self.history / (datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
                                  + f"-{prev}-{state}.json"), "w", encoding="utf-8") as fh:
            fh.write(json.dumps(entry, indent=2, sort_keys=True) + "\n")
            fh.flush()
            os.fsync(fh.fileno())
        return data


class LocalAuthorization:
    """Physical-console authorization token. Remote sessions can never
    create it; that is the whole point."""

    def __init__(self, run_dir: pathlib.Path, config_dir: pathlib.Path):
        self.token = run_dir / AUTH_TOKEN
        self.flag = config_dir / ALLOW_FLAG

    @staticmethod
    def session_tty() -> str:
        try:
            return os.readlink(f"/proc/{os.getpid()}/fd/0")
        except OSError:
            return "unknown"

    def remote_session(self) -> bool:
        # fail closed: anything that is not a physical console counts as remote
        # (ssh pts, pipes, redirected files, unknown fds...)
        return self.session_tty() not in LOCAL_TTYS

    def create(self) -> int:
        if self.remote_session():
            print("ERROR: authorization refused for remote session "
                  f"(tty={self.session_tty()}). "
                  "authorize-local must run on a physical console (ttyS2/tty1).")
            return EXIT_AUTH
        expiry = datetime.now(timezone.utc) + timedelta(seconds=AUTH_TTL_SECONDS)
        payload = json.dumps({
            "issued": now_iso(),
            "expires": expiry.isoformat(timespec="seconds"),
            "tty": self.session_tty(),
            "ttl_seconds": AUTH_TTL_SECONDS,
        }, indent=2) + "\n"
        atomic_write(self.token, payload)
        print(f"local authorization granted until {expiry.isoformat(timespec='seconds')}")
        return EXIT_OK

    def valid(self) -> (bool, str):
        if not self.token.exists():
            return False, f"missing {self.token} (authorize on the physical console)"
        try:
            data = json.loads(self.token.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError) as exc:
            return False, f"unreadable authorization token: {exc}"
        expires = datetime.fromisoformat(data["expires"])
        if datetime.now(timezone.utc) > expires:
            return False, "authorization token expired"
        return True, data.get("tty", "tty")

    def binding_ok(self, **expected) -> (bool, str):
        """One-shot tokens may carry a binding dict; when present, every
        expected field must match exactly (fail closed on any mismatch or
        missing binding)."""
        try:
            data = json.loads(self.token.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError) as exc:
            return False, f"unreadable authorization token: {exc}"
        binding = data.get("binding")
        if not isinstance(binding, dict):
            return False, "authorization token carries no binding; "
        "remote boot mutation requires a bound token"
        for key, want in expected.items():
            got = binding.get(key)
            if got != want:
                return False, f"binding mismatch for {key}: {got!r} != {want!r}"
        return True, "binding ok"

    def boot_mutation_allowed(self) -> (bool, str):
        if not self.flag.exists():
            return False, ("Boot mutation disabled. Create explicit local "
                           "authorization token while physically present.")
        ok, why = self.valid()
        if not ok:
            return False, why
        return True, "authorized"


# ---------------------------------------------------------------- bundles --

class Bundle:
    """A verified-in-place .tar.zst kernel bundle."""

    def __init__(self, archive: pathlib.Path):
        self.archive = archive
        self.top = None
        self.manifest = None
        self.report = None

    def _tar(self, *args):
        return run(["tar", "--zstd", *args])

    def list_members(self):
        r = self._tar("-tf", str(self.archive))
        if r.returncode != 0:
            raise ValueError(f"unreadable archive: {r.stderr.strip()[:200]}")
        return r.stdout.splitlines()

    def read_member(self, member: str) -> str:
        r = run(["tar", "--zstd", "-xOf", str(self.archive), member])
        if r.returncode != 0:
            raise ValueError(f"cannot read member {member}: {r.stderr.strip()[:200]}")
        return r.stdout

    def load_manifest(self):
        members = self.list_members()
        tops = {m.split("/")[0] for m in members if m.strip()}
        if len(tops) != 1:
            raise ValueError(f"expected exactly one top-level dir, saw {sorted(tops)}")
        self.top = tops.pop()
        manifest_member = f"{self.top}/manifest.json"
        if manifest_member not in members:
            raise ValueError(f"missing {manifest_member}")
        self.manifest = json.loads(self.read_member(manifest_member))
        report_member = f"{self.top}/verification-report.json"
        if report_member in members:
            try:
                self.report = json.loads(self.read_member(report_member))
            except json.JSONDecodeError:
                self.report = None
        return members


def verify_bundle(archive: pathlib.Path, expect_release: str = None,
                  tmp_root: pathlib.Path = None) -> dict:
    """18-point verification. Returns report dict; raises on failure."""
    checks = []

    def check(name, ok, detail=""):
        checks.append({"check": name, "ok": bool(ok), "detail": str(detail)})
        if not ok:
            raise VerifyError(name, detail)

    bundle = Bundle(archive)

    # 1 archive readable
    try:
        members = bundle.list_members()
        check("archive_readable", True, f"{len(members)} members")
    except ValueError as exc:
        check("archive_readable", False, str(exc))
        raise

    # 2/3 path traversal + absolute paths
    evil = [m for m in members
            if m.startswith("/") or ".." in pathlib.PurePosixPath(m).parts]
    check("no_path_traversal", not evil, f"offending: {evil[:3]}")

    bundle.load_manifest()
    files = bundle.manifest.get("files", [])
    check("manifest_present", bool(files), f"{len(files)} entries")

    # manifest completeness: every archive file member must be manifest-listed,
    # except the manifest itself (it cannot contain its own hash)
    listed = {f["path"] for f in files}
    top_depth = len(bundle.top.split("/"))
    unmanifested = []
    for m in members:
        if m.endswith("/") or m == f"{bundle.top}/manifest.json":
            continue
        rel = "/".join(m.split("/")[top_depth:])
        if rel not in listed:
            unmanifested.append(rel)
    check("manifest_exhaustive", not unmanifested, f"unmanifested: {unmanifested[:3]}")

    # 4/5 bundle sha256
    archive_sha = sha256_file(archive)
    check("bundle_sha256_computed", True, archive_sha)
    sidecar = archive.with_suffix(archive.suffix + ".sha256")
    if sidecar.exists():
        expected = sidecar.read_text(encoding="utf-8").split()[0].strip()
        check("bundle_sha256_matches_sidecar", expected == archive_sha,
              f"{expected} vs {archive_sha}")

    # 6 per-file sha256 + size (verify only the non-module payload exhaustively,
    # sample-verify modules to bound cost on small boards)
    tmp_root = tmp_root or pathlib.Path(tempfile.mkdtemp(prefix="eaidk-ota-verify-"))
    tmp_root.mkdir(parents=True, exist_ok=True)
    payload = [f for f in files if not f["path"].startswith("root/lib/modules/")]
    modules = [f for f in files if f["path"].startswith("root/lib/modules/")]
    extract_list = tmp_root / "extract-list.txt"
    extract_list.write_text(
        "\n".join(f"{bundle.top}/{f['path']}" for f in payload) + "\n",
        encoding="utf-8")
    r = run(["tar", "--zstd", "-xf", str(archive), "-C", str(tmp_root),
             "--files-from", str(extract_list)])
    check("payload_extract", r.returncode == 0, r.stderr.strip()[:200])

    bad = []
    for entry in payload:
        p = tmp_root / bundle.top / entry["path"]
        if not p.is_file() or sha256_file(p) != entry["sha256"]:
            bad.append(entry["path"])
    check("payload_sha256", not bad, f"mismatched: {bad[:3]}")
    size_bad = [f["path"] for f in files
                if (tmp_root / bundle.top / f["path"]).exists()
                and (tmp_root / bundle.top / f["path"]).stat().st_size != f["size"]]
    check("payload_sizes", not size_bad, f"mismatched: {size_bad[:3]}")

    # 7 board identity marker inside the DTB (bytes, no dtc dependency)
    dtb_entry = next((f for f in files
                      if f["path"].startswith("boot/dtb/") and f["path"].endswith(".dtb")), None)
    check("dtb_present", dtb_entry is not None, "no .dtb in bundle")
    dtb_bytes = (tmp_root / bundle.top / dtb_entry["path"]).read_bytes()
    check("dtb_board_identity", b"openailab,eaidk-310" in dtb_bytes
          and b"rockchip,rk3328" in dtb_bytes, "model/compatible markers missing")

    # 8 kernel release consistency across manifest paths
    releases = {re.search(r"-(\d+\.\d+\.\d+-eaidk310-zramfix1)(?:\.|$)", f["path"]).group(1)
                for f in files
                if re.search(r"-(\d+\.\d+\.\d+-eaidk310-zramfix1)(?:\.|$)", f["path"])}
    check("release_consistent", len(releases) == 1, f"saw {sorted(releases)}")
    release = releases.pop() if len(releases) == 1 else None
    if expect_release:
        check("release_matches_request", release == expect_release,
              f"{release} != {expect_release}")

    # 9/10/11 module release dir + no foreign kernels
    mod_tops = {f["path"].split("/")[3]
                for f in modules if len(f["path"].split("/")) > 4}
    check("modules_single_release", mod_tops == {release}, f"saw {sorted(mod_tops)}")
    check("no_foreign_modules", not any(
        m in mod_tops for m in ("6.8.4-rk3328", "6.12.108-eaidk310-zramfix1",
                                "6.12.111-eaidk310-zramfix1")),
        f"foreign kernels in bundle: {sorted(mod_tops)}")

    image_entry = next((f for f in files if f["path"] == f"boot/Image-{release}"), None)
    check("image_present", image_entry is not None, f"boot/Image-{release} missing")

    # 12 initramfs modules release (uInitrd is a packed image; the build gate
    # covers its content - here we check presence + the pipeline report)
    uinitrd_entry = next((f for f in files if f["path"] == f"boot/uInitrd-{release}"), None)
    check("uinitrd_present", uinitrd_entry is not None, f"boot/uInitrd-{release} missing")

    # 13 LOCALVERSION embedded in the kernel image
    image_path = tmp_root / bundle.top / f"boot/Image-{release}"
    image_bytes = image_path.read_bytes()
    check("image_localversion", release.encode() in image_bytes,
          f"{release} string not found in Image")

    # 14/15 config invariants (ZRAM lz4, EAIDK310 invariants) are attested at
    # build time by the pipeline gate and re-checked at runtime by `health`.
    report = bundle.report or {}
    check("build_gate_pass", report.get("gate") == "PASS",
          f"verification-report gate={report.get('gate')}")
    check("build_release_matches", report.get("kernel_release") == release,
          f"{report.get('kernel_release')} != {release}")

    # 16 module file count sanity vs pipeline report (report counts *.ko* only;
    # depmod metadata files are additional and excluded here)
    ko_modules = [f for f in modules if f["path"].endswith(".ko")]
    if report.get("module_files"):
        check("module_count_matches_report",
              len(ko_modules) == report["module_files"],
              f"{len(ko_modules)} != {report.get('module_files')}")

    # 17 no absolute WSL build paths inside any extracted text payload
    leak = []
    for entry in payload:
        p = tmp_root / bundle.top / entry["path"]
        if entry["path"].endswith((".py", ".sh", ".txt", ".conf", ".json")):
            try:
                if "/home/Fog/eaidk310-kernel" in p.read_text(encoding="utf-8", errors="ignore"):
                    leak.append(entry["path"])
            except OSError:
                pass
    check("no_build_path_leak", not leak, f"leaks: {leak[:3]}")

    # 18 size sanity: image/uInitrd in plausible ranges
    ok_sizes = (5 << 20) < image_entry["size"] < (64 << 20) and \
               (5 << 20) < uinitrd_entry["size"] < (64 << 20)
    check("size_plausible", ok_sizes,
          f"image={image_entry['size']} uinitrd={uinitrd_entry['size']}")

    result = {
        "archive": str(archive),
        "bundle_sha256": archive_sha,
        "release": release,
        "checks": checks,
        "all_ok": True,
        "verified_at": now_iso(),
    }
    shutil.rmtree(tmp_root, ignore_errors=True)
    return result


class VerifyError(Exception):
    def __init__(self, check: str, detail: str):
        super().__init__(f"verify failed at '{check}': {detail}")
        self.check = check
        self.detail = detail


