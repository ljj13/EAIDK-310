def cmd_inspect(args) -> int:
    bundle = Bundle(pathlib.Path(args.bundle))
    members = bundle.list_members()
    bundle.load_manifest()
    files = bundle.manifest.get("files", [])
    payload = {"archive": str(bundle.archive), "members": len(members),
               "manifest_entries": len(files),
               "total_bytes": sum(f["size"] for f in files),
               "top": bundle.top,
               "release_hint": sorted({mm.split("-")[0] for mm in members
                                       if "zramfix1" in mm})[:3]}
    print(json.dumps(payload, indent=2, sort_keys=True))
    return EXIT_OK


def cmd_verify(args) -> int:
    try:
        report = verify_bundle(pathlib.Path(args.bundle),
                               expect_release=args.release or None)
    except VerifyError as exc:
        print(f"VERIFY=FAIL: {exc}")
        return EXIT_VERIFY
    except ValueError as exc:
        print(f"VERIFY=FAIL: {exc}")
        return EXIT_VERIFY
    report["VERIFY"] = "PASS"
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        for c in report["checks"]:
            if c["ok"]:
                print(f"  PASS  {c['check']}")
            else:
                print(f"  FAIL  {c['check']}  {c['detail']}")
        print("VERIFY=PASS")
    return EXIT_OK


def cmd_stage(args) -> int:
    state = StateStore(pathlib.Path(args.state_dir))
    archive = pathlib.Path(args.bundle)
    if not archive.exists():
        return fail_exit(EXIT_ERROR, f"bundle not found: {archive}")
    with state.locked():
        data = state.read()
        try:
            report = verify_bundle(archive)
        except (VerifyError, ValueError) as exc:
            state.write("FAILED", stage_error=str(exc)[:200])
            return fail_exit(EXIT_VERIFY, f"VERIFY=FAIL: {exc}")
        release = report["release"]
        staging = pathlib.Path(args.state_dir) / STAGING_NAME / release
        marker = staging / ".bundle.sha256"
        if staging.exists():
            if marker.exists() and marker.read_text().strip() == report["bundle_sha256"]:
                state.write("STAGED", release=release,
                            bundle_sha256=report["bundle_sha256"],
                            candidate_identity=data.get("candidate_identity"))
                print(f"STAGE=PASS (already staged, idempotent) release={release}")
                return EXIT_OK
            return fail_exit(EXIT_CONFLICT,
                             f"release {release} already staged with a different "
                             "hash; refusing to overwrite")
        tmp = pathlib.Path(tempfile.mkdtemp(prefix=".staging-tmp-",
                                            dir=staging.parent))
        tar_r = run(["tar", "--zstd", "-xf", str(archive), "-C", str(tmp)])
        if tar_r.returncode != 0:
            shutil.rmtree(tmp, ignore_errors=True)
            return fail_exit(EXIT_ERROR, f"extract failed: {tar_r.stderr[:200]}")
        extracted = tmp / f"eaidk310-linux-{release}"
        if not extracted.is_dir():
            shutil.rmtree(tmp, ignore_errors=True)
            return fail_exit(EXIT_ERROR, "unexpected bundle layout after extract")
        # stage only what install needs; keep the bundle's own manifest
        target = staging
        target.mkdir(parents=True, exist_ok=True)
        for item in ("boot", "root", "deploy", "manifest.json",
                     "verification-report.json"):
            src = extracted / item
            if src.exists():
                shutil.move(str(src), str(target / item))
        atomic_write(marker, report["bundle_sha256"] + "\n")
        shutil.rmtree(tmp, ignore_errors=True)
        # fsync the staged tree
        for root, _dirs, fnames in os.walk(target):
            fd = os.open(root, os.O_DIRECTORY)
            os.fsync(fd)
            os.close(fd)
            for fn in fnames:
                fd = os.open(os.path.join(root, fn), os.O_RDONLY)
                os.fsync(fd)
                os.close(fd)
        state.write("STAGED", release=release,
                    bundle_sha256=report["bundle_sha256"])
        print(f"STAGE=PASS release={release} at {target}")
        return EXIT_OK


def cmd_status(args) -> int:
    state = StateStore(pathlib.Path(args.state_dir))
    data = state.read()
    staged = []
    staging_root = pathlib.Path(args.state_dir) / STAGING_NAME
    if staging_root.exists():
        for rel in sorted(staging_root.iterdir()):
            marker = rel / ".bundle.sha256"
            staged.append({"release": rel.name,
                           "bundle_sha256": marker.read_text().strip() if marker.exists() else None})
    backend = select_backend(pathlib.Path(args.boot_dir), args.backend,
                             args.bootstate_tool, args.raw_device)
    try:
        bootstate = backend.inspect() if backend.available() else None
    except BackendError:
        bootstate = {"state": "unreadable", "bootcount": 0,
                     "upgrade_available": 0, "fail_closed": True}
    payload = {"state": data.get("state"), "updated": data.get("updated"),
               "release": data.get("release"),
               "bundle_sha256": data.get("bundle_sha256"),
               "staged": staged,
               "failsafe_boot_backend": FAILSAFE_BOOT_BACKEND,
               "active_backend": backend.name,
               "backend_available": backend.available(),
               "bootstate": bootstate,
               "tool_version": VERSION}
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(f"state:      {payload['state']}")
        print(f"release:    {payload['release']}")
        print(f"updated:    {payload['updated']}")
        print(f"backend:    {FAILSAFE_BOOT_BACKEND} "
              f"(active: {backend.name}, available: {backend.available()})")
        if bootstate is not None:
            print(f"bootstate:  bootcount={bootstate.get('bootcount')} "
                  f"upgrade_available={bootstate.get('upgrade_available')} "
                  f"({bootstate.get('state')})")
        for s in staged:
            print(f"staged:     {s['release']} ({(s['bundle_sha256'] or '?')[:16]}…)")
    return EXIT_OK


def cmd_history(args) -> int:
    history = pathlib.Path(args.state_dir) / HISTORY_NAME
    entries = []
    if history.exists():
        for f in sorted(history.glob("*.json")):
            try:
                entries.append(json.loads(f.read_text(encoding="utf-8")))
            except json.JSONDecodeError:
                continue
    if args.json:
        print(json.dumps(entries, indent=2, sort_keys=True))
    else:
        for e in entries[-20:]:
            print(f"{e.get('at')}  {e.get('from')} -> {e.get('to')}  "
                  f"release={e.get('release', '-')}")
    return EXIT_OK


def current_default_entry(boot_dir: pathlib.Path) -> dict:
    """Parse the current default extlinux entry (label + APPEND line)."""
    conf = boot_dir / "extlinux" / "extlinux.conf"
    text = conf.read_text(encoding="utf-8")
    default = next((ln.split(None, 1)[1].strip() for ln in text.splitlines()
                    if ln.startswith("default ")), None)
    append = next((ln.split(None, 1)[1].strip() for ln in text.splitlines()
                   if ln.strip().startswith("APPEND ")), None)
    labels = [ln.split(None, 1)[1].strip() for ln in text.splitlines()
              if ln.strip().startswith("label ")]
    return {"conf": str(conf), "text": text, "default": default,
            "append": append, "labels": labels}


# --------------------------------------------------------------------------
# P8.1 candidate trial contract: the candidate extlinux entry is part of
# the installation (never an operator step), and arming refuses unless the
# whole candidate deployment is provably consistent.
# --------------------------------------------------------------------------

TRIAL_MARKER_PREFIX = "eaidk_ota_trial="
# Canonical copies of ota/templates/eaidk-trial-feed{,.service}; a Tier-1
# test asserts these stay byte-identical to the template files.
TRIAL_FEED_SCRIPT = '''#!/bin/sh
# eaidk-trial-feed (P3.7, hardened P8.2): hardware-watchdog feeder for
# candidate trial boots.
#
# U-Boot starts the trial watchdog ONLY when the raw bootstate confirms a
# candidate trial (armed, increment within bootlimit).  The running kernel
# auto-pings the watchdog (CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y) until this
# service opens /dev/watchdog0; from that moment feeding is ours:
#   - trial boot (eaidk_ota_trial= in cmdline): feed every 10 s while the
#     bootstate says upgrade_available=1; exit (magic 'V' then close -- the
#     ONLY clean stop for a U-Boot-started watchdog) once the trial is
#     committed or cleared.
#   - hang injection (eaidk_ota_hang_test=1 also present): feed once, then
#     deliberately stop feeding while holding the fd open -- the watchdog
#     fires after its TOP and the SoC resets, bootcount exceeds the
#     bootlimit, and altbootcmd rolls back to the stable entry.
#     EMPIRICAL (2026-10-05): a plain close also leaves the WDT running
#     unfed (kernel auto-ping does not resume after the first close), so a
#     crashed/killed feeder converges to the same hardware reset.
#   - any other boot: refuse immediately (watchdog is not ours).
#
# Test hooks (fixtures only): EAIDK_TEST_CMDLINE is the boot cmdline as a
# literal string; EAIDK_CANDIDATE_CONF overrides the candidate conf path.

cmdline="${EAIDK_TEST_CMDLINE:-$(cat /proc/cmdline 2>/dev/null)}"
CONF="${EAIDK_CANDIDATE_CONF:-/boot/extlinux/extlinux-candidate.conf}"
case "$cmdline" in
  *eaidk_ota_trial=*) ;;
  *) echo "eaidk-trial-feed: not a candidate trial boot; refusing" >&2
     exit 0 ;;
esac

trial_marker=$(printf '%s\n' "$cmdline" | tr ' ' '\n' | grep '^eaidk_ota_trial=' | head -1)
conf_marker=$(grep -o 'eaidk_ota_trial=[^ ]*' "$CONF" 2>/dev/null | head -1)
if [ -z "$conf_marker" ] || [ "$conf_marker" != "$trial_marker" ]; then
  echo "eaidk-trial-feed: candidate identity mismatch (cmdline=$trial_marker conf=$conf_marker); refusing" >&2
  exit 3
fi

WD="${EAIDK_TEST_WATCHDOG:-/dev/watchdog0}"
[ -e "$WD" ] || { echo "eaidk-trial-feed: no watchdog device at $WD" >&2; exit 1; }
exec 3>"$WD" || exit 1
printf 'x' >&3 || exit 1
echo "eaidk-trial-feed: watchdog ownership taken ($trial_marker)"

case "$cmdline" in
  *eaidk_ota_hang_test=1*)
    echo "eaidk-trial-feed: HANG TEST engaged - feeds stop now, fd stays open"
    exec /bin/sleep infinity
    ;;
esac

while :; do
  sleep 10
  # Ask the OTA state machine (not the raw record reader -- its CLI takes a
  # record file, not a device).  Probe failure => KEEP FEEDING: a hung board
  # must reset via the fd we hold, a healthy trial must never be reset by a
  # transient probe error.
  upg=$("${EAIDK_TEST_OTA_STATUS:-/usr/local/sbin/eaidk-ota}" --json status 2>/dev/null | \
        python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("bootstate", {}).get("upgrade_available"))
except Exception: print("ERR")' 2>/dev/null)
  if [ "$upg" = "0" ]; then
    # trial committed/cleared: magic 'V' then close -- the ONLY clean stop
    # for a U-Boot-started watchdog.
    printf 'V' >&3
    echo "eaidk-trial-feed: trial no longer armed; watchdog released (magic V)"
    exit 0
  fi
  # upgrade_available=1 (or probe error): keep feeding.
  printf 'x' >&3 || exit 1
done
'''
TRIAL_FEED_UNIT = '''[Unit]
Description=EAIDK-310 candidate trial watchdog feeder
# Runs ONLY on armed candidate trial boots (the install-candidate trial
# entry carries eaidk_ota_trial= in the cmdline).  Normal stable boots skip
# this unit entirely -- the trial watchdog is never ours to feed there.
ConditionKernelCommandLine=eaidk_ota_trial
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/eaidk-trial-feed
Restart=no

[Install]
WantedBy=multi-user.target
'''
TRIAL_FEED_BIN = "/usr/local/sbin/eaidk-trial-feed"
# The production unit name is the P3.7 deployment's (eaidk-ota-trial-feed);
# install-trial-feed writes OUR unit only when no unit already references
# the feeder binary, so an operator-managed unit is never clobbered.
TRIAL_FEED_UNIT_PATH = "/etc/systemd/system/eaidk-ota-trial-feed.service"

CANDIDATE_CONF = "extlinux/extlinux-candidate.conf"


def candidate_trial_marker(release: str, bundle_sha: str) -> str:
    return f"{TRIAL_MARKER_PREFIX}{release}@{bundle_sha[:12]}"


def render_candidate_conf(stable_append: str, release: str, marker: str,
                          dtb_name: str) -> str:
    """Candidate trial entry: versioned kernel assets, the RUNNING board's
    kernel command line (taken from the stable default entry -- the bundle's
    build-time APPEND has carried a stale root UUID before), and the trial
    identity marker."""
    label = f"rockchip-kernel-{release}-test"
    return (
        f"default {label}\n"
        "timeout 5\n"
        f"menu title EAIDK-310 candidate trial ({release})\n"
        "\n"
        f"label {label}\n"
        f"    LINUX  /Image-{release}\n"
        f"    FDT    /dtb/rockchip/{dtb_name}\n"
        f"    INITRD /uInitrd-{release}\n"
        f"    APPEND {stable_append} {marker}\n"
    )


def _fsync_dir(path: pathlib.Path) -> None:
    dirfd = os.open(str(path), os.O_DIRECTORY)
    try:
        os.fsync(dirfd)
    finally:
        os.close(dirfd)


def atomic_write_text(path: pathlib.Path, text: str) -> None:
    tmp = path.with_name(path.name + ".tmp-write")
    with tmp.open("w", encoding="utf-8") as handle:
        handle.write(text)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(tmp, path)
    _fsync_dir(path.parent)


def readback_validate_candidate_conf(conf: pathlib.Path, release: str,
                                     marker: str, dtb_name: str) -> dict:
    """Parse the written conf and prove it references exactly the installed
    candidate assets; raises ValueError on any mismatch."""
    text = conf.read_text(encoding="utf-8")
    label = f"rockchip-kernel-{release}-test"
    default = next((ln.split(None, 1)[1].strip() for ln in text.splitlines()
                    if ln.startswith("default ")), None)
    if default != label:
        raise ValueError(f"conf default is {default!r}, expected {label!r}")
    linux = next((ln.split(None, 1)[1].strip() for ln in text.splitlines()
                  if ln.strip().startswith("LINUX ")), None)
    if linux != f"/Image-{release}":
        raise ValueError(f"conf LINUX is {linux!r}, expected /Image-{release}")
    initrd = next((ln.split(None, 1)[1].strip() for ln in text.splitlines()
                   if ln.strip().startswith("INITRD ")), None)
    if initrd != f"/uInitrd-{release}":
        raise ValueError(f"conf INITRD is {initrd!r}, expected /uInitrd-{release}")
    fdt = next((ln.split(None, 1)[1].strip() for ln in text.splitlines()
                if ln.strip().startswith("FDT ")), None)
    if fdt != f"/dtb/rockchip/{dtb_name}":
        raise ValueError(f"conf FDT is {fdt!r}, expected /dtb/rockchip/{dtb_name}")
    append = next((ln.split(None, 1)[1].strip() for ln in text.splitlines()
                   if ln.strip().startswith("APPEND ")), None)
    if not append or marker not in append.split():
        raise ValueError(f"conf APPEND lacks trial marker {marker!r}")
    return {"label": label, "linux": linux, "fdt": fdt, "initrd": initrd,
            "append": append, "marker": marker}


def install_candidate_conf(boot_dir: pathlib.Path, release: str,
                           bundle_sha: str, dtb_name: str,
                           hang_test: bool = False) -> dict:
    """Generate /boot/extlinux/extlinux-candidate.conf atomically from the
    running stable command line plus the trial marker, then read it back.
    hang_test injects eaidk_ota_hang_test=1 (P3.7 TEST C semantics: the
    feeder feeds once and then deliberately stops; the WDT resets the SoC).
    Opt-in and audit-visible via the conf digest."""
    stable = current_default_entry(boot_dir)
    if not stable["append"]:
        raise ValueError("stable extlinux default entry has no APPEND line")
    marker = candidate_trial_marker(release, bundle_sha)
    stable_append = stable["append"]
    if hang_test:
        stable_append += " eaidk_ota_hang_test=1"
    conf_text = render_candidate_conf(stable_append, release, marker, dtb_name)
    conf = boot_dir / CANDIDATE_CONF
    atomic_write_text(conf, conf_text)
    parsed = readback_validate_candidate_conf(conf, release, marker, dtb_name)
    return {
        "release": release,
        "bundle_sha256": bundle_sha,
        "backend": FAILSAFE_BOOT_BACKEND,
        "marker": marker,
        "conf": str(conf),
        "conf_sha256": sha256_file(conf),
        "stable_default": stable["default"],
        "parsed": parsed,
    }


def prearm_contract(boot_dir: pathlib.Path, state_dir: pathlib.Path,
                    release: str, bundle_sha: str, backend_name: str,
                    raw_state: dict | None,
                    modules_root: str = "/lib/modules",
                    watchdog_gates: bool = False,
                    feeder_bin: str = None,
                    feeder_unit: str = None,
                    watchdog_dev: str = None,
                    sysfs_watchdog: str = "/sys/class/watchdog/watchdog0"
                    ) -> list[tuple[str, bool, str]]:
    """ARM_ALLOWED checklist (P8.1).  Pure reads: never mutates anything.
    Any False refuses the arm before the raw bootstate is touched."""
    boot = pathlib.Path(boot_dir)
    staging = pathlib.Path(state_dir) / STAGING_NAME / release
    state_file = pathlib.Path(state_dir) / STATE_FILE
    state = json.loads(state_file.read_text(encoding="utf-8")) \
        if state_file.exists() else {}
    identity = state.get("candidate_identity") or {}
    checks: list[tuple[str, bool, str]] = []

    def add(name: str, ok: bool, detail: str = "") -> None:
        checks.append((name, bool(ok), detail))

    marker = candidate_trial_marker(release, bundle_sha)
    conf = boot / CANDIDATE_CONF

    add("candidate_conf_present", conf.is_file())
    conf_text = conf.read_text(encoding="utf-8", errors="replace") \
        if conf.is_file() else ""
    dtb_name = (identity.get("parsed", {}).get("fdt") or "").rsplit("/", 1)[-1]
    parsed: dict = {}
    try:
        parsed = readback_validate_candidate_conf(conf, release, marker, dtb_name)
        add("candidate_conf_parseable", True)
    except (ValueError, OSError) as exc:
        add("candidate_conf_parseable", False, str(exc)[:160])
    add("candidate_conf_identity_matches_plan",
        bool(identity) and identity.get("marker") == marker
        and identity.get("conf_sha256") == (sha256_file(conf) if conf.is_file() else ""),
        f"state marker={identity.get('marker', 'none')}")
    add("candidate_conf_refs_expected_image",
        f"/Image-{release}" in conf_text)
    add("candidate_conf_refs_expected_uinitrd",
        f"/uInitrd-{release}" in conf_text)
    dtb_line = next((ln.split(None, 1)[1].strip() for ln in conf_text.splitlines()
                     if ln.strip().startswith("FDT ")), "")
    dtb_rel = dtb_line
    dtb_on_boot = boot / dtb_rel.lstrip("/") if dtb_rel else None
    add("candidate_conf_refs_expected_dtb",
        bool(dtb_rel) and dtb_on_boot is not None and dtb_on_boot.is_file(), dtb_rel)

    staged_image = staging / "boot" / f"Image-{release}"
    staged_uinitrd = staging / "boot" / f"uInitrd-{release}"
    staged_dtb_dir = staging / "boot" / "dtb" / "rockchip"
    staged_dtb = next(iter(sorted(staged_dtb_dir.glob("*.dtb"))), None) \
        if staged_dtb_dir.is_dir() else None
    boot_image = boot / f"Image-{release}"
    boot_uinitrd = boot / f"uInitrd-{release}"
    add("image_hash_matches_plan",
        staged_image.is_file() and boot_image.is_file()
        and sha256_file(boot_image) == sha256_file(staged_image))
    add("uinitrd_hash_matches_plan",
        staged_uinitrd.is_file() and boot_uinitrd.is_file()
        and sha256_file(boot_uinitrd) == sha256_file(staged_uinitrd))
    add("dtb_hash_matches_plan",
        staged_dtb is not None and dtb_on_boot is not None and dtb_on_boot.is_file()
        and sha256_file(dtb_on_boot) == sha256_file(staged_dtb))

    mod_dst = pathlib.Path(modules_root) / release
    add("module_tree_present", mod_dst.is_dir())
    add("modules_dep_present", (mod_dst / "modules.dep").is_file())
    mod_marker = mod_dst / ".eaidk-ota-installed"
    mod_marker_ok = False
    if mod_marker.is_file():
        body = mod_marker.read_text(encoding="utf-8", errors="replace")
        mod_marker_ok = (f"release={release}" in body
                         and (not bundle_sha or bundle_sha in body))
    add("module_release_matches_candidate", mod_dst.is_dir() and mod_marker_ok)
    add("install_marker_matches_candidate", mod_marker_ok)

    add("trial_marker_present_in_append",
        marker in (parsed.get("append") or conf_text))
    stable = None
    try:
        stable = current_default_entry(boot)
    except OSError:
        pass
    root_of = lambda s: next(
        (tok for tok in (s or "").split() if tok.startswith("root=")), "")
    add("append_root_matches_stable",
        bool(stable and stable["append"])
        and root_of(parsed.get("append")) == root_of(stable["append"]),
        root_of(parsed.get("append")))
    add("rollback_target_is_current_stable",
        bool(stable and stable["default"]
             and stable["default"] != f"rockchip-kernel-{release}-test"
             and stable["default"] in stable["labels"]),
        f"default={stable.get('default') if stable else 'unreadable'}")

    backend_marker = boot / "eaidk-ota" / "BACKEND"
    add("backend_identity_pass",
        backend_marker.is_file()
        and backend_marker.read_text(encoding="utf-8").strip().split()[:1] == [backend_name])
    safe = False
    if isinstance(raw_state, dict):
        reason = str(raw_state.get("reason", ""))
        if raw_state.get("fail_closed") and "does not exist" not in reason:
            safe = False
        elif raw_state.get("upgrade_available"):
            safe = identity.get("release") == release
        else:
            safe = True
    add("raw_state_currently_safe", safe, json.dumps(raw_state or {})[:80])

    if not watchdog_gates:
        return checks
    # ---- P8.2 watchdog userspace handoff gates ----
    feeder_path = pathlib.Path(feeder_bin or TRIAL_FEED_BIN)
    add("trial_feed_binary_present",
        feeder_path.is_file() and os.access(feeder_path, os.X_OK),
        str(feeder_path))
    unit_path = pathlib.Path(feeder_unit or TRIAL_FEED_UNIT_PATH)
    unit_text = unit_path.read_text(encoding="utf-8") if unit_path.is_file() else ""
    add("trial_feed_unit_present", unit_path.is_file())
    add("trial_feed_unit_valid",
        "ExecStart=" in unit_text and TRIAL_FEED_BIN in unit_text,
        "unit must run the feeder binary (its own policy decides when)")
    wd_dev = pathlib.Path(watchdog_dev or "/dev/watchdog0")
    add("watchdog_device_present", wd_dev.exists(), str(wd_dev))
    add("kernel_watchdog_handoff_supported",
        (pathlib.Path(sysfs_watchdog).is_dir() if sysfs_watchdog else True)
        or (wd_dev is not None and wd_dev.exists()),
        "dw_wdt + watchdog core with HANDLE_BOOT (P3.7/P1.8 empirical)")
    conf_marker = ""
    for ln in conf_text.splitlines():
        if ln.strip().startswith("APPEND "):
            for tok in ln.split():
                if tok.startswith(TRIAL_MARKER_PREFIX):
                    conf_marker = tok
    add("candidate_trial_marker_valid",
        bool(conf_marker) and conf_marker == identity.get("marker"),
        conf_marker)
    add("feeder_can_identify_current_trial",
        bool(conf_marker) and conf_marker == (parsed.get("marker") or conf_marker))
    if pathlib.Path("/run/systemd/system").exists():
        r = run(["systemctl", "is-active", "eaidk-trial-feed"])
        state_txt = (r.stdout or "").strip()
        add("feeder_not_active_on_normal_stable_boot",
            state_txt in ("inactive", "failed", "unknown", ""),
            state_txt or "not-found")
    else:
        add("feeder_not_active_on_normal_stable_boot", True, "no systemd (fixture)")
    return checks


def cmd_plan_install(args) -> int:
    state = StateStore(pathlib.Path(args.state_dir))
    release = args.release
    staging = pathlib.Path(args.state_dir) / STAGING_NAME / release
    if not staging.exists():
        return fail_exit(EXIT_ERROR, f"release not staged: {release}")
    boot = pathlib.Path(args.boot_dir)
    dtb_dir = staging / "boot/dtb/rockchip"
    dtb_src = next(iter(sorted(dtb_dir.glob("*.dtb"))), None) if dtb_dir.exists() else None
    if dtb_src is None:
        return fail_exit(EXIT_ERROR, "staged bundle contains no DTB under boot/dtb/rockchip")
    targets = {
        "image": boot / f"Image-{release}",
        "uinitrd": boot / f"uInitrd-{release}",
        "dtb": boot / "dtb/rockchip" / dtb_src.name,
    }
    sources = {
        "image": staging / f"boot/Image-{release}",
        "uinitrd": staging / f"boot/uInitrd-{release}",
        "dtb": dtb_src,
    }
    sizes = {k: src.stat().st_size for k, src in sources.items()}
    for name, target in targets.items():
        if target.exists():
            if sha256_file(target) != sha256_file(sources[name]):
                return fail_exit(EXIT_CONFLICT,
                                 f"{target} exists with different content; "
                                 "refusing to overwrite a boot file")
    label = f"rockchip-kernel-{release}"
    ext = current_default_entry(boot)
    if label in ext["labels"]:
        return fail_exit(EXIT_CONFLICT, f"extlinux label already present: {label}")
    if not ext["append"]:
        return fail_exit(EXIT_ERROR, "current extlinux.conf has no APPEND line to inherit")
    df = run(["df", "-BM", "--output=avail", str(boot)])
    try:
        avail_mib = int(df.stdout.splitlines()[1].strip().rstrip("M"))
    except (IndexError, ValueError):
        avail_mib = -1
    need_mib = (sum(sizes.values()) + (1 << 20) - 1) >> 20
    plan = {
        "would_install": {k: str(v) for k, v in targets.items()},
        "sizes_bytes": sizes,
        "required_boot_mib": need_mib,
        "available_boot_mib": avail_mib,
        "extlinux_entry": {
            "label": label,
            "LINUX": f"/Image-{release}",
            "FDT": f"/dtb/rockchip/{dtb_src.name}",
            "INITRD": f"/uInitrd-{release}",
            "APPEND": ext["append"],
            "note": "APPEND inherited verbatim from the current default entry",
        },
        "current_default": ext["default"],
        "default_will_change": False,
        "labels_after": ext["labels"] + [label],
        "rollback_backend": FAILSAFE_BOOT_BACKEND,
    }
    ok = need_mib <= avail_mib and avail_mib > 0
    plan["space_ok"] = ok
    if args.json:
        print(json.dumps(plan, indent=2, sort_keys=True))
    else:
        print("Would install:")
        for k, v in plan["would_install"].items():
            print(f"  {v}  ({sizes[k]} bytes)")
        print("Would append extlinux entry:")
        for k, v in plan["extlinux_entry"].items():
            print(f"  {k:8} {v}")
        print(f"Current default: {plan['current_default']} (unchanged)")
        print(f"Candidate:       {release}")
        print(f"Rollback backend: {FAILSAFE_BOOT_BACKEND}")
        print(f"Boot space: need {need_mib} MiB, available {avail_mib} MiB -> "
              f"{'OK' if ok else 'INSUFFICIENT'}")
    return EXIT_OK if ok else EXIT_ERROR


def _atomic_copy(src: pathlib.Path, dst: pathlib.Path) -> None:
    """Copy src->dst via same-directory temp + fsync + rename + dir fsync."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    tmp = dst.with_name(dst.name + ".tmp-install")
    with open(src, "rb") as fin, open(tmp, "wb") as fout:
        while True:
            chunk = fin.read(1 << 20)
            if not chunk:
                break
            fout.write(chunk)
        fout.flush()
        os.fsync(fout.fileno())
    os.chmod(tmp, 0o644)
    os.replace(tmp, dst)
    dirfd = os.open(str(dst.parent), os.O_DIRECTORY)
    try:
        os.fsync(dirfd)
    finally:
        os.close(dirfd)


def cmd_install_candidate(args) -> int:
    auth = LocalAuthorization(args.run_dir, args.config_dir)
    allowed, why = auth.boot_mutation_allowed()
    if not allowed:
        return fail_exit(EXIT_AUTH, f"ERROR: {why}")
    state = StateStore(pathlib.Path(args.state_dir))
    data = state.read()
    release = data.get("release")
    if data.get("state") != "STAGED" or not release:
        return fail_exit(EXIT_CONFLICT,
                         f"install requires state STAGED (current: {data.get('state')})")
    staging = pathlib.Path(args.state_dir) / STAGING_NAME / release
    marker = staging / ".bundle.sha256"
    bundle_sha = marker.read_text(encoding="utf-8").strip() if marker.exists() else ""
    ok, why = auth.binding_ok(
        candidate=release, bundle_sha256=bundle_sha,
        backend=FAILSAFE_BOOT_BACKEND)
    if not ok:
        return fail_exit(EXIT_AUTH, f"ERROR: {why}")
    # stable identity: current extlinux DEFAULT must equal the binding's stable
    boot = pathlib.Path(args.boot_dir)
    try:
        ext = current_default_entry(boot)
    except OSError as exc:
        return fail_exit(EXIT_ERROR, f"cannot read extlinux.conf: {exc}")
    ok, why = auth.binding_ok(stable=ext["default"])
    if not ok:
        return fail_exit(EXIT_AUTH, f"ERROR: {why}")

    src_image = staging / "boot" / f"Image-{release}"
    src_initrd = staging / "boot" / f"uInitrd-{release}"
    dtb_dir = staging / "boot" / "dtb" / "rockchip"
    dtb_src = next(iter(sorted(dtb_dir.glob("*.dtb"))), None)
    if not src_image.exists() or not src_initrd.exists() or dtb_src is None:
        return fail_exit(EXIT_ERROR, "staged tree is missing kernel artifacts")
    targets = {
        src_image: boot / f"Image-{release}",
        src_initrd: boot / f"uInitrd-{release}",
        dtb_src: boot / "dtb" / "rockchip" / dtb_src.name,
    }
    # refuse overwriting a different-content boot file; versioned names must
    # be new (or byte-identical for idempotent re-run)
    for src, dst in targets.items():
        if dst.exists() and sha256_file(dst) != sha256_file(src):
            return fail_exit(EXIT_CONFLICT,
                             f"{dst} exists with different content; refusing")
    installed = {}
    for src, dst in targets.items():
        if dst.exists() and sha256_file(dst) == sha256_file(src):
            # identical content already deployed: skip the copy so an
            # idempotent re-install needs no transient /boot space
            installed[str(dst)] = sha256_file(src) + " (unchanged)"
            continue
        _atomic_copy(src, dst)
        if sha256_file(dst) != sha256_file(src):
            return fail_exit(EXIT_ERROR, f"post-install hash mismatch: {dst}")
        installed[str(dst)] = sha256_file(src)

    # Rootfs modules: without them every =m subsystem (zram, nf_tables,
    # tun, ...) fails on the candidate boot -- the P4 first-attempt root
    # cause.  Deploy the staged tree atomically; depmod metadata ships in
    # the bundle and its presence is verified.
    mod_src = staging / "root" / "lib" / "modules" / release
    mod_dst = pathlib.Path("/lib/modules") / release
    if not mod_src.is_dir():
        return fail_exit(EXIT_ERROR, f"staged modules tree missing: {mod_src}")
    if not (mod_src / "modules.dep").is_file():
        return fail_exit(EXIT_ERROR,
                         "staged modules tree lacks modules.dep (depmod "
                         "metadata); refusing to install")
    if mod_dst.exists():
        marker = mod_dst / ".eaidk-ota-installed"
        if not marker.is_file():
            return fail_exit(EXIT_CONFLICT,
                             f"{mod_dst} already exists and was not installed "
                             "by eaidk-ota; refusing to touch it")
    else:
        tmp_dir = mod_dst.with_name(release + ".tmp-install")
        r = run(["cp", "-a", str(mod_src), str(tmp_dir)])
        if r.returncode != 0:
            return fail_exit(EXIT_ERROR,
                             f"modules copy failed: {r.stderr.strip()[:200]}")
        marker = tmp_dir / ".eaidk-ota-installed"
        marker.write_text("release=%s\\nbundle=%s\\n" % (release, bundle_sha))
        os.replace(tmp_dir, mod_dst)
        dirfd = os.open("/lib/modules", os.O_DIRECTORY)
        try:
            os.fsync(dirfd)
        finally:
            os.close(dirfd)
    installed[str(mod_dst)] = (sha256_file(mod_src / "modules.dep")
                               + f" ({sum(1 for _ in mod_dst.rglob('*.ko*'))} modules)")

    # P8.1: the candidate extlinux entry is part of the installation.  It is
    # generated from the running stable command line plus the trial identity
    # marker, written atomically, and read back before success is declared.
    try:
        candidate_identity = install_candidate_conf(
            boot, release, bundle_sha, dtb_src.name,
            hang_test=bool(getattr(args, "inject_hang_test", False)))
    except (ValueError, OSError) as exc:
        return fail_exit(EXIT_ERROR,
                         f"candidate conf generation failed: {exc}")
    installed[candidate_identity["conf"]] = candidate_identity["conf_sha256"]

    state.write("STAGED", installed=installed,
                candidate_identity=candidate_identity,
                note=f"installed {release} versioned files to /boot, "
                     "modules to /lib/modules and the candidate trial entry")
    print("INSTALL=PASS")
    for dst, h in installed.items():
        print(f"  {dst}  {h[:16]}…")
    return EXIT_OK


def cmd_authorize_local(args) -> int:
    auth = LocalAuthorization(args.run_dir, args.config_dir)
    return auth.create()


def _backend_or_refusal(args):
    """Common gate for try/arm/commit/rollback: backend capability first
    (a hard infeasibility, stable exit 4 whenever no backend is installed),
    then local authorization for the actual mutation."""
    backend = select_backend(pathlib.Path(args.boot_dir), args.backend,
                             args.bootstate_tool, args.raw_device)
    if not backend.available():
        return None, fail_exit(EXIT_BACKEND, backend.unavailable_reason())
    auth = LocalAuthorization(args.run_dir, args.config_dir)
    allowed, why = auth.boot_mutation_allowed()
    if not allowed:
        return None, fail_exit(EXIT_AUTH, f"ERROR: {why}")
    return backend, None


def cmd_install_trial_feed(args) -> int:
    """Install the trial watchdog feeder (P8.2): binary + systemd unit with
    the trial-cmdline condition, then enable it.  Persistent infrastructure
    (not a boot mutation): needs root, not the local-authorization token."""
    if os.geteuid() != 0:
        return fail_exit(EXIT_AUTH, "install-trial-feed must run as root")
    bin_path = pathlib.Path(TRIAL_FEED_BIN)
    unit_path = pathlib.Path(TRIAL_FEED_UNIT_PATH)
    atomic_write_text(bin_path, TRIAL_FEED_SCRIPT)
    os.chmod(bin_path, 0o755)
    if unit_path.is_file():
        existing = unit_path.read_text(encoding="utf-8")
        if TRIAL_FEED_BIN not in existing:
            return fail_exit(EXIT_CONFLICT,
                             f"{unit_path} exists but does not run "
                             f"{TRIAL_FEED_BIN}; not clobbering it")
        print(f"unit already present and references {TRIAL_FEED_BIN}; kept")
    else:
        unit_path.parent.mkdir(parents=True, exist_ok=True)
        atomic_write_text(unit_path, TRIAL_FEED_UNIT)
        run(["systemctl", "daemon-reload"])
    r_enable = run(["systemctl", "is-enabled", unit_path.name])
    if "enabled" not in (r_enable.stdout or ""):
        run(["systemctl", "enable", unit_path.name])
    print("TRIAL_FEED_INSTALL=PASS")
    print(f"  {bin_path}")
    print(f"  {unit_path} (enabled; runs only on eaidk_ota_trial= boots)")
    return EXIT_OK


def cmd_install_candidate_hang_test(args) -> int:
    args.inject_hang_test = True
    return cmd_install_candidate(args)


def cmd_try(args) -> int:
    backend, refusal = _backend_or_refusal(args)
    if refusal is not None:
        return refusal
    state = StateStore(pathlib.Path(args.state_dir))
    data = state.read()
    if data.get("state") not in ("STAGED", "ARMED"):
        return fail_exit(EXIT_CONFLICT,
                         f"arm requires a staged candidate "
                         f"(current: {data.get('state')})")
    release = data.get("release")
    bundle_sha = data.get("bundle_sha256") or ""
    raw_state = backend.inspect() if hasattr(backend, "inspect") else None
    checks = prearm_contract(pathlib.Path(args.boot_dir),
                             pathlib.Path(args.state_dir),
                             release, bundle_sha, backend.name, raw_state,
                             modules_root=getattr(args, "modules_dir", "/lib/modules"),
                             watchdog_gates=True,
                             feeder_bin=getattr(args, "trial_feed_bin", None),
                             feeder_unit=getattr(args, "trial_feed_unit", None),
                             watchdog_dev=getattr(args, "watchdog_dev", None))
    failed = [c for c in checks if not c[1]]
    if failed:
        print("ARM_REFUSED (raw bootstate untouched):")
        for name, _, detail in failed:
            print(f"  FAIL  {name}" + (f"  [{detail}]" if detail else ""))
        passed = [name for name, ok, _ in checks if ok]
        print(f"  {len(passed)}/{len(checks)} contract checks passed")
        return fail_exit(EXIT_AUTH, "pre-arm candidate contract failed")
    for name, _, _ in checks:
        print(f"  PASS  {name}")
    if data.get("state") == "ARMED":
        bootstate = backend.inspect()
        print(f"already armed via {backend.name}; bootstate unchanged "
              f"(bootcount={bootstate.get('bootcount')}, "
              f"upgrade_available={bootstate.get('upgrade_available')})")
        return EXIT_OK
    try:
        bootstate = backend.arm()
    except BackendError as exc:
        return fail_exit(EXIT_ERROR, str(exc))
    state.write("ARMED", release=data.get("release"),
                bundle_sha256=data.get("bundle_sha256"),
                candidate_identity=data.get("candidate_identity"),
                backend=backend.name, bootstate=bootstate)
    print(f"candidate armed via {backend.name}: {backend.state_path()}")
    print("reboot now: U-Boot runs one candidate trial (bootlimit=1); "
          "a failed trial falls back to the stable extlinux entry")
    return EXIT_OK


def cmd_arm(args) -> int:
    return cmd_try(args)


def cmd_commit(args) -> int:
    state = StateStore(pathlib.Path(args.state_dir))
    data = state.read()
    if data.get("state") not in ("HEALTHY", "HEALTH_PENDING"):
        return fail_exit(EXIT_CONFLICT,
                         f"commit requires state HEALTHY (current: {data.get('state')})")
    backend, refusal = _backend_or_refusal(args)
    if refusal is not None:
        return refusal
    try:
        bootstate = backend.clear()
    except BackendError as exc:
        return fail_exit(EXIT_ERROR, str(exc))
    state.write("COMMITTED", release=data.get("release"),
                bundle_sha256=data.get("bundle_sha256"),
                backend=backend.name, bootstate=bootstate,
                note="bootcount cleared: candidate is the new stable default")
    print(f"candidate committed via {backend.name}; "
          "bootstate cleared (bootcount=0, upgrade_available=0)")
    return EXIT_OK


def cmd_rollback(args) -> int:
    backend, refusal = _backend_or_refusal(args)
    if refusal is not None:
        return refusal
    state = StateStore(pathlib.Path(args.state_dir))
    data = state.read()
    if data.get("state") not in ("HEALTH_PENDING", "HEALTHY", "ARMED",
                                 "FAILED", "ROLLBACK_PENDING"):
        return fail_exit(EXIT_CONFLICT,
                         f"rollback not applicable in state {data.get('state')}")
    try:
        bootstate = backend.clear()
    except BackendError as exc:
        return fail_exit(EXIT_ERROR, str(exc))
    state.write("ROLLED_BACK", previous_release=data.get("release"),
                backend=backend.name, bootstate=bootstate,
                note="bootcount cleared: stable extlinux entry restored")
    print(f"rolled back via {backend.name}; "
          "bootstate cleared, stable extlinux entry is the boot default")
    return EXIT_OK


