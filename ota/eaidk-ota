def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="eaidk-ota", description=__doc__.splitlines()[0])
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.add_argument("--state-dir", default=os.environ.get("EAIDK_OTA_STATE", DEFAULT_STATE_DIR))
    p.add_argument("--boot-dir", default=os.environ.get("EAIDK_OTA_BOOT", DEFAULT_BOOT_DIR))
    p.add_argument("--modules-dir", default=os.environ.get("EAIDK_OTA_MODULES", "/lib/modules"))
    p.add_argument("--trial-feed-bin", default=TRIAL_FEED_BIN)
    p.add_argument("--trial-feed-unit", default=TRIAL_FEED_UNIT_PATH)
    p.add_argument("--watchdog-dev", default="/dev/watchdog0")
    p.add_argument("--config-dir", default=DEFAULT_CONFIG_DIR)
    p.add_argument("--run-dir", default=DEFAULT_RUN_DIR)
    p.add_argument("--backend", choices=("auto", "none", "bootcount-fs", "raw"),
                   default="auto",
                   help="fail-safe boot backend (auto reads the "
                        "eaidk-ota/BACKEND marker on the boot filesystem; "
                        "anything unexpected degrades to NoBackend)")
    p.add_argument("--bootstate-tool", default="eaidk-bootstate",
                   help="path to the eaidk-bootstate operator tool")
    p.add_argument("--raw-device", default="/dev/mmcblk2",
                   help="raw boot-state device for the RawBootstateBackend "
                        "(PC/fixture mode may point at an image file)")
    sub = p.add_subparsers(dest="command", required=True)

    ins = sub.add_parser("inspect", help="summarize a bundle without verification")
    ins.add_argument("bundle")

    ver = sub.add_parser("verify", help="full 18-point bundle verification")
    ver.add_argument("bundle")
    ver.add_argument("--release", help="expected release string")

    stg = sub.add_parser("stage", help="verify + atomically stage into the state dir")
    stg.add_argument("bundle")

    sub.add_parser("status", help="show state machine + staged releases")
    sub.add_parser("history", help="show state transition history")

    plan = sub.add_parser("plan-install", help="print the /boot install plan (no changes)")
    plan.add_argument("release")

    sub.add_parser("install-candidate", help="install staged candidate (locked: local auth)")
    sub.add_parser("install-candidate-hang-test",
                   help="install staged candidate with eaidk_ota_hang_test=1 "
                        "(P3.7 TEST C true-hang injection; audit-visible)")
    sub.add_parser("install-trial-feed",
                   help="install/enable the trial watchdog feeder (root; persistent infra)")
    health = sub.add_parser("health", help="run CRITICAL + REMOTE health checks")
    health.add_argument("--expected-release")
    health.add_argument("--network-retries", type=int, default=3)
    health.add_argument("--network-retry-wait", type=int, default=60,
                        help="seconds between remote health retries")

    sub.add_parser("authorize-local",
                   help="grant a 15-minute boot-mutation token (physical console only)")
    sub.add_parser("try", help="arm a one-shot candidate boot (requires verified backend)")
    sub.add_parser("arm", help="alias of try")
    sub.add_parser("commit", help="commit a healthy candidate (requires verified backend)")
    sub.add_parser("rollback", help="roll back to previous stable (requires verified backend)")
    return p


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    args.run_dir = pathlib.Path(args.run_dir)
    args.config_dir = pathlib.Path(args.config_dir)
    handlers = {
    "install-candidate-hang-test": cmd_install_candidate_hang_test,
    "install-trial-feed": cmd_install_trial_feed,
        "inspect": cmd_inspect, "verify": cmd_verify, "stage": cmd_stage,
        "status": cmd_status, "history": cmd_history,
        "plan-install": cmd_plan_install, "install-candidate": cmd_install_candidate,
        "health": cmd_health, "authorize-local": cmd_authorize_local,
        "try": cmd_try, "arm": cmd_arm, "commit": cmd_commit, "rollback": cmd_rollback,
    }
    return handlers[args.command](args)


if __name__ == "__main__":
    raise SystemExit(main())
