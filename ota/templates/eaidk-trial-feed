#!/bin/sh
# eaidk-trial-feed (P3.7, hardened P8.2): hardware-watchdog feeder for
# candidate trial boots.
#
# U-Boot starts the trial watchdog ONLY when the raw bootstate confirms a
# candidate trial (armed, increment within bootlimit).  The running kernel
# auto-pings the watchdog (CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y) until this
# service opens /dev/watchdog0; from that moment feeding is ours:
#   - trial boot (eaidk_ota_trial= in cmdline): feed every 10 s while the
#     bootstate says upgrade_available=1; exit (magic 'V' then close -- the
#     ONLY clean stop for a U-Boot-started watchdog) once the trial is
#     committed or cleared.
#   - hang injection (eaidk_ota_hang_test=1 also present): feed once, then
#     deliberately stop feeding while holding the fd open -- the watchdog
#     fires after its TOP and the SoC resets, bootcount exceeds the
#     bootlimit, and altbootcmd rolls back to the stable entry.
#     EMPIRICAL (2026-10-05): a plain close also leaves the WDT running
#     unfed (kernel auto-ping does not resume after the first close), so a
#     crashed/killed feeder converges to the same hardware reset.
#   - any other boot: refuse immediately (watchdog is not ours).
#
# Test hooks (fixtures only): EAIDK_TEST_CMDLINE is the boot cmdline as a
# literal string; EAIDK_CANDIDATE_CONF overrides the candidate conf path.

cmdline="${EAIDK_TEST_CMDLINE:-$(cat /proc/cmdline 2>/dev/null)}"
CONF="${EAIDK_CANDIDATE_CONF:-/boot/extlinux/extlinux-candidate.conf}"
case "$cmdline" in
  *eaidk_ota_trial=*) ;;
  *) echo "eaidk-trial-feed: not a candidate trial boot; refusing" >&2
     exit 0 ;;
esac

trial_marker=$(printf '%s\n' "$cmdline" | tr ' ' '\n' | grep '^eaidk_ota_trial=' | head -1)
conf_marker=$(grep -o 'eaidk_ota_trial=[^ ]*' "$CONF" 2>/dev/null | head -1)
if [ -z "$conf_marker" ] || [ "$conf_marker" != "$trial_marker" ]; then
  echo "eaidk-trial-feed: candidate identity mismatch (cmdline=$trial_marker conf=$conf_marker); refusing" >&2
  exit 3
fi

WD="${EAIDK_TEST_WATCHDOG:-/dev/watchdog0}"
[ -e "$WD" ] || { echo "eaidk-trial-feed: no watchdog device at $WD" >&2; exit 1; }
exec 3>"$WD" || exit 1
printf 'x' >&3 || exit 1
echo "eaidk-trial-feed: watchdog ownership taken ($trial_marker)"

case "$cmdline" in
  *eaidk_ota_hang_test=1*)
    echo "eaidk-trial-feed: HANG TEST engaged - feeds stop now, fd stays open"
    exec /bin/sleep infinity
    ;;
esac

while :; do
  sleep 10
  # Ask the OTA state machine (not the raw record reader -- its CLI takes a
  # record file, not a device).  Probe failure => KEEP FEEDING: a hung board
  # must reset via the fd we hold, a healthy trial must never be reset by a
  # transient probe error.
  upg=$("${EAIDK_TEST_OTA_STATUS:-/usr/local/sbin/eaidk-ota}" --json status 2>/dev/null | \
        python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("bootstate", {}).get("upgrade_available"))
except Exception: print("ERR")' 2>/dev/null)
  if [ "$upg" = "0" ]; then
    # trial committed/cleared: magic 'V' then close -- the ONLY clean stop
    # for a U-Boot-started watchdog.
    printf 'V' >&3
    echo "eaidk-trial-feed: trial no longer armed; watchdog released (magic V)"
    exit 0
  fi
  # upgrade_available=1 (or probe error): keep feeding.
  printf 'x' >&3 || exit 1
done
