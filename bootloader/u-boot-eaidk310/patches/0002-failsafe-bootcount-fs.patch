diff --git a/drivers/bootcount/bootcount_ext.c b/drivers/bootcount/bootcount_ext.c
index 9639e638e95..4335e7f22fc 100644
--- a/drivers/bootcount/bootcount_ext.c
+++ b/drivers/bootcount/bootcount_ext.c
@@ -4,6 +4,7 @@
  */
 
 #include <bootcount.h>
+#include <env.h>
 #include <fs.h>
 #include <mapmem.h>
 
@@ -18,6 +19,7 @@ typedef struct {
 } bootcount_ext_t;
 
 static u8 upgrade_available = 1;
+static int bootcount_store_ok;
 
 void bootcount_store(ulong a)
 {
@@ -25,13 +27,18 @@ void bootcount_store(ulong a)
 	loff_t len;
 	int ret;
 
+	bootcount_store_ok = 0;
+	env_set_ulong("bootcount_stored", bootcount_store_ok);
 	if (fs_set_blk_dev(CONFIG_SYS_BOOTCOUNT_EXT_INTERFACE,
 			   CONFIG_SYS_BOOTCOUNT_EXT_DEVPART, FS_TYPE_EXT)) {
 		puts("Error selecting device\n");
 		return;
 	}
 
-	/* Only update bootcount during upgrade process */
+	/* Only update bootcount during an armed upgrade.  upgrade_available
+	 * is 0 whenever the last bootcount_load() failed or saw a committed
+	 * record, so a missing/corrupt/booted-stable file is never rewritten.
+	 */
 	if (!upgrade_available)
 		return;
 
@@ -45,8 +52,12 @@ void bootcount_store(ulong a)
 	ret = fs_write(CONFIG_SYS_BOOTCOUNT_EXT_NAME,
 		       CONFIG_SYS_BOOTCOUNT_ADDR, 0, sizeof(bootcount_ext_t),
 		       &len);
-	if (ret != 0)
+	if (ret != 0) {
 		puts("Error storing bootcount\n");
+		return;
+	}
+	bootcount_store_ok = 1;
+	env_set_ulong("bootcount_stored", bootcount_store_ok);
 }
 
 ulong bootcount_load(void)
@@ -58,13 +69,20 @@ ulong bootcount_load(void)
 	if (fs_set_blk_dev(CONFIG_SYS_BOOTCOUNT_EXT_INTERFACE,
 			   CONFIG_SYS_BOOTCOUNT_EXT_DEVPART, FS_TYPE_EXT)) {
 		puts("Error selecting device\n");
+		upgrade_available = 0;
+		env_set_ulong("upgrade_available", upgrade_available);
 		return 0;
 	}
 
+	/* Read one extra byte and demand an exact-length record: a longer
+	 * file is corrupt and must fail closed, not be trusted by prefix.
+	 */
 	ret = fs_read(CONFIG_SYS_BOOTCOUNT_EXT_NAME, CONFIG_SYS_BOOTCOUNT_ADDR,
-		      0, sizeof(bootcount_ext_t), &len_read);
+		      0, sizeof(bootcount_ext_t) + 1, &len_read);
 	if (ret != 0 || len_read != sizeof(bootcount_ext_t)) {
 		puts("Error loading bootcount\n");
+		upgrade_available = 0;
+		env_set_ulong("upgrade_available", upgrade_available);
 		return 0;
 	}
 
@@ -75,9 +93,18 @@ ulong bootcount_load(void)
 			ret = buf->bootcount;
 	} else {
 		puts("Incorrect bootcount file\n");
+		upgrade_available = 0;
 	}
 
 	unmap_sysmem(buf);
 
+	/*
+	 * Export the trial state for the bootcmd script.  A missing,
+	 * corrupt, truncated or committed record always reports
+	 * upgrade_available=0 so that bootcmd falls back to the standard
+	 * bootflow scan (stable).  Fail closed, never fail open.
+	 */
+	env_set_ulong("upgrade_available", upgrade_available);
+
 	return ret;
 }
diff --git a/include/configs/rk3328_common.h b/include/configs/rk3328_common.h
index 2c40674b224..8be2194780c 100644
--- a/include/configs/rk3328_common.h
+++ b/include/configs/rk3328_common.h
@@ -22,11 +22,34 @@
 	"kernel_comp_addr_r=0x08000000\0" \
 	"kernel_comp_size=0x2000000\0"
 
+/*
+ * Fail-safe OTA boot policy (P3.6).  Only compiled into builds that
+ * enable the BOOTCOUNT_EXT boot-state backend
+ * (eaidk310-failsafe-fs-rk3328_defconfig); control and sdio-handoff
+ * binaries are unaffected byte for byte.
+ *
+ * altbootcmd is selected by the bootcount framework when the stored
+ * bootcount exceeds CONFIG_BOOTCOUNT_BOOTLIMIT (compiled bootlimit=1):
+ * it boots the stable extlinux entry and, should that fail, falls
+ * back to the standard bootflow scan.  Trial state lives exclusively
+ * in the bootcount file; the mutable U-Boot environment is never
+ * written.
+ */
+#ifdef CONFIG_BOOTCOUNT_EXT
+#define CFG_EAIDK310_FAILSAFE_ENV_SETTINGS \
+	"altbootcmd=sysboot mmc 0:1 ext2 ${scriptaddr} /extlinux/extlinux.conf; " \
+	"bootflow scan\0" \
+	"bootcount_file=/eaidk-ota/bootcount.bin\0"
+#else
+#define CFG_EAIDK310_FAILSAFE_ENV_SETTINGS
+#endif
+
 #define CFG_EXTRA_ENV_SETTINGS \
 	ENV_MEM_LAYOUT_SETTINGS \
 	"fdtfile=" CONFIG_DEFAULT_FDT_FILE "\0" \
 	"partitions=" PARTS_DEFAULT \
 	ROCKCHIP_DEVICE_SETTINGS \
-	"boot_targets=" BOOT_TARGETS "\0"
+	"boot_targets=" BOOT_TARGETS "\0" \
+	CFG_EAIDK310_FAILSAFE_ENV_SETTINGS
 
 #endif
