def fmt_bytes(num_bytes):
    if num_bytes is None:
        return "?"
    val = float(num_bytes)
    for unit in ("B", "KiB", "MiB", "GiB"):
        if abs(val) < 1024 or unit == "GiB":
            return f"{val:.1f}{unit}"
        val /= 1024
    return f"{val:.1f}GiB"


def render(data, indent=0):
    """Minimal generic renderer: nested dicts/lists as aligned lines."""
    pad = "  " * indent
    lines = []
    if isinstance(data, dict):
        for key, val in data.items():
            if isinstance(val, (dict, list)):
                lines.append(f"{pad}{key}:")
                lines.extend(render(val, indent + 1))
            else:
                lines.append(f"{pad}{key}: {val}")
    elif isinstance(data, list):
        for item in data:
            if isinstance(item, (dict, list)):
                lines.extend(render(item, indent))
                lines.append("")
            else:
                lines.append(f"{pad}- {item}")
    else:
        lines.append(f"{pad}{data}")
    return lines


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="eaidk-health", description="EAIDK-310 runtime health snapshot")
    parser.add_argument("--version", action="version",
                        version=f"eaidk-health {VERSION}")
    parser.add_argument("view", choices=sorted(VIEWS),
                        help="which health view to collect")
    parser.add_argument("--json", action="store_true",
                        help="emit a single JSON object")
    args = parser.parse_args(argv)

    try:
        data = VIEWS[args.view]()
    except Exception as exc:  # view-level failure
        print(f"eaidk-health: failed to collect '{args.view}': {exc}",
              file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(data, indent=2, sort_keys=False, default=str))
    else:
        print(f"eaidk-health {args.view} @ {data['collected_at']}")
        for line in render(data):
            print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
